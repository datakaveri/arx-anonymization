{
    "operations": [
      "suppress",
      "pseudonymize",
      "k_anonymize"
    ],
    "dataset_name": "synthetic_financial_transactions_raw.csv",
    "data_type": "finance",
    "finance": {
      "sensitive_column": [
        "TransactionCategory"
      ],
      "insensitive_columns": [
        "Gender"
      ],
      "suppress": [
        "CustomerName"
      ],
      "pseudonymize": [
        "Address"
      ],
      "generalize": [
        "TransactionAmount",
        "Age"
      ],
      "width": {
        "TransactionAmount": 50,
        "Age": 6
      },
      "levels": {
        "TransactionAmount": 15,
        "Age": 6
      },
      "k_anonymize": {
        "k": 500,
        "l":1,
        "t":1
      },
      "allow_record_suppression": true
    }
  }